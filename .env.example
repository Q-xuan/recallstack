# RepoWiki configuration
# Copy to .env and fill in your values

# LLM provider API keys (set at least one for high-quality wiki/generation)
# AGNES_API_KEY and DEEPSEEK_API_KEY also select their hub's model and
# endpoint, so either one alone is a complete setup.
# AGNES_API_KEY=sk-xxx
# DEEPSEEK_API_KEY=sk-xxx
# OPENAI_API_KEY=sk-xxx
# ANTHROPIC_API_KEY=sk-xxx

# Default model (optional, defaults to deepseek/deepseek-chat)
# Aliases: agnes -> agnes/agnes-2.0-flash, agnes-2.5 -> agnes/agnes-2.5-flash
# REPOWIKI_MODEL=agnes/agnes-2.0-flash
# REPOWIKI_API_KEY=
# Only needed for hubs without a built-in default (agnes and deepseek have one).
# Agnes: https://apihub.agnes-ai.com/v1
# REPOWIKI_API_BASE=
# REPOWIKI_LLM_TIMEOUT_SECONDS=90
# REPOWIKI_LLM_MAX_RETRIES=1
# LLM transport: auto (curl-first; avoids Python TLS-fingerprint blocking on
# some compatible hubs) | curl | httpx
# REPOWIKI_LLM_TRANSPORT=auto
# Minimum seconds between LLM calls (throttle for strict-RPM hubs)
# REPOWIKI_LLM_MIN_INTERVAL=1.5

# SourcePeek teaching annotations (lazy, first peek). Analyze stays on
# REPOWIKI_MODEL (Jake: deepseek-v4-flash). This is the non-flash sibling on
# the same OpenCode-compatible hub — do not invent a model id the hub lacks.
# REPOWIKI_ANNOTATE_MODEL=openai/deepseek-v4
# REPOWIKI_ANNOTATE_API_KEY=
# REPOWIKI_ANNOTATE_API_BASE=

# Output language (en, zh, ja, ko)
# REPOWIKI_LANG=en

# RecallStack learning database (separate from RepoWiki cache)
RECALLSTACK_DATABASE_URL=sqlite:///./data/recallstack.db
RECALLSTACK_DEFAULT_USER_ID=00000000-0000-4000-8000-000000000001
RECALLSTACK_FSRS_DESIRED_RETENTION=0.9
RECALLSTACK_MAX_REPOSITORY_SIZE_MB=200
RECALLSTACK_MAX_FILE_SIZE_KB=200
# Optional LLM enrichment (falls back to deterministic path when off / no key)
# RECALLSTACK_LLM_ENABLED=1
# RECALLSTACK_LLM_EVALUATION=1
# Content language for generated wiki + learning text (same codes as RepoWiki)
# en | zh | ja | ko — resolution order:
#   RECALLSTACK_CONTENT_LANG → REPOWIKI_LANG → ~/.repowiki/config.json language → en
# REPOWIKI_LANG=en
# RECALLSTACK_CONTENT_LANG=zh
